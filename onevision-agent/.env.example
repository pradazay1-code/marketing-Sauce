# ---- Required -----------------------------------------------------------
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
DASHBOARD_PASSWORD=pick-a-strong-password
CRON_SECRET=generate-a-long-random-string

# ---- Model provider -----------------------------------------------------
# gemini (default) or anthropic
LLM_PROVIDER=gemini

# Gemini — free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. /api/health lists valid IDs if this one is wrong.
GEMINI_MODEL=gemini-3.7-flash

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---- Telegram alerts (recommended) --------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Gmail (optional) ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Stripe (optional) --------------------------------------------------
STRIPE_SECRET_KEY=

# ---- Tuning -------------------------------------------------------------
AGENT_NAME=VERA
