{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape-step",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/automation",
      "schedule": "30 9 * * *"
    }
  ]
}
